{
  "name": "Smistino — tutti i tuoi messaggi, già smistati",
  "short_name": "Smistino",
  "description": "Email illimitate, WhatsApp, Telegram, SMS e altre app in un posto solo: Smistino riconosce da solo in quale sezione va ogni messaggio.",
  "lang": "it",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f5fb",
  "theme_color": "#5b4fe0",
  "categories": ["productivity", "communication", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/logo.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Da smistare", "url": "./#/posta/smistare", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "In arrivo", "url": "./#/scadenze", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
